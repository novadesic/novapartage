####
# Dockerfile legacy pour le backend ddsshare en mode native
# Optimisé pour compatibilité CPU maximale
#
# Build de l'application:
# ./mvnw clean package -Dnative
#
# Construction de l'image:
# docker build -f src/main/docker/Dockerfile.native-legacy -t ghcr.io/novadesic/novapartage-backend:latest .
#
# Exécution du conteneur:
# docker run -i --rm -p 8080:8080 ghcr.io/novadesic/novapartage-backend:latest
####

# Utiliser une image de base très compatible
FROM registry.access.redhat.com/ubi8/ubi-minimal:8.9

# Installation des dépendances minimales nécessaires
RUN microdnf update -y && \
    microdnf install -y \
        freetype \
        fontconfig \
        ca-certificates \
        glibc-langpack-en \
        && microdnf clean all

# Configuration du répertoire de travail
WORKDIR /work/

# Configuration des permissions
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work

# Copie de l'exécutable natif
COPY --chown=1001:root --chmod=0755 target/*-runner /work/application

# Exposition du port
EXPOSE 8080

# Utilisateur non-root pour la sécurité
USER 1001

# Point d'entrée avec configuration pour compatibilité CPU maximale
ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0", "-Dquarkus.http.port=8080"] 