# ===========================================
# NovaPartage — variables d'environnement
# Copier vers .env puis : ./scripts/generate-secrets.sh --write
# ===========================================

# ===========================================
# Backend Quarkus (obligatoire en prod)
# ===========================================
# Générer avec ./scripts/generate-secrets.sh — doit être identique à JWT_SECRET
APP_AUTH_JWT_SECRET=
# Clé de chiffrement fichiers (Base64, 32 bytes) — obligatoire en self-host
APP_ENCRYPTION_MASTER_KEY=
APP_FILE_STORAGE_BASE_PATH=/app/files

DB_HOST=postgres
DB_PORT=5432
DB_NAME=novapartage
DB_USERNAME=novapartage
DB_PASSWORD=

# ===========================================
# Frontend Docker (self-host)
# ===========================================
CUSTOM_AUTH_ENDPOINT=http://localhost/auth
BACKEND_URL=http://localhost/backend
BACKEND_API_PATH=/api
APP_NAME=NovaPartage
APP_VERSION=1.0.0
PRODUCTION=true
MAX_RECIPIENTS_PER_SHARE=5
MAX_FILE_SIZE=50MB
MAX_SELECTED_COLUMNS=20

# ===========================================
# Configuration de base
# ===========================================
NODE_ENV=development
AUTH_PORT=3001
LOG_LEVEL=info

# ===========================================
# Configuration JWT (auth-service)
# ===========================================
# Doit être identique à APP_AUTH_JWT_SECRET
JWT_SECRET=
JWT_EXPIRES_IN=30m
JWT_ALGORITHM=HS256
JWT_ISSUER=novapartage-auth
JWT_AUDIENCE=novapartage-frontend
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# Configuration de Session
# ===========================================
MAX_SESSION_DURATION=36000
MAX_REFRESH_COUNT=20
MAX_IDLE_TIME=1800

# ===========================================
# Configuration Redis
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# ===========================================
# Configuration CSRF
# ===========================================
CSRF_SECRET=

# ===========================================
# Configuration Sécurité
# ===========================================
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=false

# ===========================================
# Configuration CORS
# ===========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,http://localhost:4200

# ===========================================
# Configuration URLs
# ===========================================
FRONTEND_URL=http://localhost
AUTH_CALLBACK_URL=http://localhost/auth/callback

# ===========================================
# Configuration SMTP (développement — Mailpit)
# ===========================================
SMTP_ENABLED=true
SMTP_NAME=smtp-default
SMTP_PRIORITY=10
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@novapartage.fr
SMTP_IGNORE_TLS=true
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=false

# ===========================================
# Configuration Email Service
# ===========================================
EMAIL_PORT=3002
EMAIL_HOST=0.0.0.0
EMAIL_SUBJECT="Lien de connexion NovaPartage"

# ===========================================
# Configuration Mailjet (optionnel)
# ===========================================
MAILJET_ENABLED=false
MAILJET_NAME=mailjet-default
MAILJET_PRIORITY=5
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=no-reply@novapartage.fr
MAILJET_FROM_NAME="NovaPartage"

# ===========================================
# Configuration Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
TOKEN_RATE_LIMIT_WINDOW_MS=900000
TOKEN_RATE_LIMIT_MAX_REQUESTS=300
EMAIL_RATE_LIMIT_WINDOW_MS=3600000
EMAIL_RATE_LIMIT_MAX_REQUESTS=10

# ===========================================
# Configuration Cookies
# ===========================================
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost
COOKIE_HTTP_ONLY=true
COOKIE_MAX_AGE=3600000

# ===========================================
# Configuration Stockage (auth frontend)
# ===========================================
TOKEN_STORAGE_METHOD=localStorage
JWT_VALIDATION_MODE=client

# ===========================================
# Configuration Tokens
# ===========================================
TEMP_TOKEN_EXPIRES_IN=1h
VERIFICATION_CODE_EXPIRES_IN=15m
MAX_VERIFICATION_ATTEMPTS=5

# ===========================================
# PostgreSQL (docker-compose)
# ===========================================
POSTGRES_DB=novapartage
POSTGRES_USER=novapartage
POSTGRES_PASSWORD=
