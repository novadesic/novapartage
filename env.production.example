# ===========================================
# Configuration NovaPartage - Production
# ===========================================

# ===========================================
# Configuration de base
# ===========================================
NODE_ENV=production
AUTH_PORT=3001
LOG_LEVEL=warn

# ===========================================
# Configuration JWT (Production)
# ===========================================
JWT_SECRET=your-very-secure-jwt-secret-key-for-production
JWT_EXPIRES_IN=1h
JWT_ALGORITHM=HS256
JWT_ISSUER=novapartage-auth
JWT_AUDIENCE=novapartage-frontend

# ===========================================
# Configuration Redis (Production)
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-very-secure-redis-password
REDIS_DB=0
REDIS_ENABLED=true

# ===========================================
# Configuration CSRF (Production)
# ===========================================
CSRF_SECRET=your-very-secure-csrf-secret

# ===========================================
# Configuration Sécurité (Production)
# ===========================================
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true

# ===========================================
# Configuration CORS (Production)
# ===========================================
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===========================================
# Configuration URLs (Production)
# ===========================================
FRONTEND_URL=https://yourdomain.com
AUTH_CALLBACK_URL=https://yourdomain.com/auth/callback

# ===========================================
# Configuration SMTP (Production)
# ===========================================
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourdomain.com

# ===========================================
# Configuration Email (Production)
# ===========================================
EMAIL_SUBJECT=Lien de connexion NovaPartage

# ===========================================
# Configuration Rate Limiting (Production)
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
EMAIL_RATE_LIMIT_WINDOW_MS=3600000
EMAIL_RATE_LIMIT_MAX_REQUESTS=10

# ===========================================
# Configuration Cookies (Production)
# ===========================================
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=yourdomain.com
COOKIE_HTTP_ONLY=true
COOKIE_MAX_AGE=3600000

# ===========================================
# Configuration Stockage (Production)
# ===========================================
TOKEN_STORAGE_METHOD=cookies
JWT_VALIDATION_MODE=server

# ===========================================
# Configuration Base de données (Production)
# ===========================================
POSTGRES_DB=novapartage_auth
POSTGRES_USER=novapartage
POSTGRES_PASSWORD=your-very-secure-postgres-password

MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your-very-secure-mongo-password
MONGO_DATABASE=novapartage

