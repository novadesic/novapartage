# Multi-stage build — NovaPartage frontend (Angular 17 + nginx)
#
# Build : docker build -f Dockerfile.selfhost -t novapartage-frontend .

FROM node:18-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# env.js avec placeholders remplacés au runtime par replace-env.sh
RUN cat > src/assets/env.js <<'EOL'
(function(window) {
  window.__env = window.__env || {};
  window.__env.CUSTOM_AUTH_ENDPOINT = '%%CUSTOM_AUTH_ENDPOINT%%';
  window.__env.BACKEND_URL = '%%BACKEND_URL%%';
  window.__env.BACKEND_API_PATH = '%%BACKEND_API_PATH%%';
  window.__env.APP_NAME = '%%APP_NAME%%';
  window.__env.APP_VERSION = '%%APP_VERSION%%';
  window.__env.PRODUCTION = %%PRODUCTION%%;
  window.__env.MAX_RECIPIENTS_PER_SHARE = %%MAX_RECIPIENTS_PER_SHARE%%;
  window.__env.MAX_FILE_SIZE = '%%MAX_FILE_SIZE%%';
  window.__env.MAX_SELECTED_COLUMNS = %%MAX_SELECTED_COLUMNS%%;
})(this);
EOL

RUN npm run build -- --configuration production

FROM nginx:stable-alpine AS runtime

RUN apk add --no-cache bash sed

COPY --from=build /app/dist/ddsshare-app/browser/ /usr/share/nginx/html/
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY scripts/replace-env.sh /usr/local/bin/replace-env.sh
COPY docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /usr/local/bin/replace-env.sh /entrypoint.sh

ENV CUSTOM_AUTH_ENDPOINT=http://localhost/auth \
    BACKEND_URL=http://localhost/backend \
    BACKEND_API_PATH=/api \
    APP_NAME=NovaPartage \
    APP_VERSION=1.0.0 \
    PRODUCTION=true \
    MAX_RECIPIENTS_PER_SHARE=5 \
    MAX_FILE_SIZE=50MB \
    MAX_SELECTED_COLUMNS=20

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/entrypoint.sh"]
