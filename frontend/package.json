{
  "name": "novapartage-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --allowed-hosts host.docker.internal --host 0.0.0.0 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "e2e:headless": "start-server-and-test start http://localhost:4200 'cypress run'",
    "test:integration": "./run-integration-tests.sh",
    "test:integration:start": "./run-integration-tests.sh --start-only",
    "test:integration:run": "./run-integration-tests.sh --test-only",
    "test:integration:ui": "./run-integration-tests.sh --ui",
    "test:integration:ui:slow": "./run-integration-tests.sh --slow-ui",
    "test:integration:cleanup": "./run-integration-tests.sh --cleanup-only",
    "test:integration:verbose": "./run-integration-tests.sh --verbose"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@popperjs/core": "^2.11.8",
    "ag-grid-angular": "^34.2.0",
    "ag-grid-community": "^34.2.0",
    "bootstrap": "^5.3.6",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jasmine": "~5.1.0",
    "cypress": "^14.4.1",
    "cypress-file-upload": "^5.0.8",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "start-server-and-test": "^2.0.12",
    "typescript": "~5.4.2"
  }
}
